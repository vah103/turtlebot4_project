#!/usr/bin/env bash
set -Eeuo pipefail

LAB_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${LAB_DIR}/.." && pwd)"
ROS_SETUP="${ROS_SETUP:-/opt/ros/jazzy/setup.bash}"
WS_SETUP="${ROOT_DIR}/ros2_ws/install/setup.bash"
PYTHON_BIN="${PYTHON_BIN:-/usr/bin/python3}"
LAUNCH_PID=""

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

if [[ ! -t 0 ]]; then
    fail "This runner is interactive; run it from a terminal."
fi

printf '\n=== mapex_lab runner ===\n'
printf 'Chọn thuật toán:\n'
printf '  1) NF (Nearest Frontier)\n'
printf '  2) MapEx\n'

while true; do
    read -r -p '> ' choice
    case "${choice,,}" in
        1|nf|nearest)
            METHOD="nf"
            break
            ;;
        2|mapex|map-ex)
            METHOD="mapex"
            break
            ;;
        q|quit|exit)
            exit 0
            ;;
        *)
            printf 'Chọn 1 (NF) hoặc 2 (MapEx).\n'
            ;;
    esac
done

printf '\nChọn map:\n'
printf '  1) New Room\n'
printf '  2) Hospital\n'

while true; do
    read -r -p '> ' map_choice
    case "${map_choice,,}" in
        1|new_room|new-room|newroom|room)
            ENVIRONMENT="new_room"
            WORLD_SELECTOR="new_room"
            RUNTIME_PROFILE="slam"
            MAP_LABEL="New Room"
            break
            ;;
        2|hospital|hospital_flat|hospital-flat)
            ENVIRONMENT="hospital"
            WORLD_SELECTOR="hospital"
            RUNTIME_PROFILE="hospital_slam"
            MAP_LABEL="Hospital"
            break
            ;;
        q|quit|exit)
            exit 0
            ;;
        *)
            printf 'Chọn 1 (New Room) hoặc 2 (Hospital).\n'
            ;;
    esac
done

while true; do
    read -r -p 'Lưu record? [y/N]: ' record_answer
    case "${record_answer,,}" in
        y|yes)
            RECORD=1
            break
            ;;
        ''|n|no)
            RECORD=0
            break
            ;;
        *)
            printf 'Nhập y hoặc n.\n'
            ;;
    esac
done

RUN_ID=""
if (( RECORD )); then
    if [[ "$METHOD" == "nf" ]]; then
        RUN_BASE="${LAB_DIR}/experiments/nearest"
    else
        RUN_BASE="${LAB_DIR}/experiments/mapex"
    fi

    while true; do
        read -r -p 'Tên run: ' RUN_ID
        if [[ -z "$RUN_ID" ]]; then
            printf 'Tên run không được để trống.\n'
            continue
        fi
        if [[ ! "$RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            printf 'Chỉ dùng chữ, số, dấu chấm, gạch dưới hoặc gạch ngang.\n'
            continue
        fi
        if [[ -e "${RUN_BASE}/${RUN_ID}" ]]; then
            printf 'Run "%s" đã tồn tại. Chọn tên khác.\n' "$RUN_ID"
            continue
        fi
        break
    done
fi

[[ -f "$ROS_SETUP" ]] || fail "Không tìm thấy ROS setup: ${ROS_SETUP}"
[[ -f "$WS_SETUP" ]] || fail "Không tìm thấy workspace setup: ${WS_SETUP}. Hãy build ros2_ws trước."
[[ -f "${LAB_DIR}/launch/slam.launch.py" ]] || fail "Không tìm thấy mapex_lab/launch/slam.launch.py"
[[ -x "$PYTHON_BIN" ]] || fail "Không tìm thấy ROS Python executable: ${PYTHON_BIN}"

# ROS / ament setup scripts may legitimately read variables that are not set.
# Temporarily disable nounset while sourcing them, then restore strict mode.
set +u
# shellcheck disable=SC1090
source "$ROS_SETUP"
# shellcheck disable=SC1090
source "$WS_SETUP"
set -u

# Keep simulation isolated from the real TurtleBot and other computers. This
# also prevents stale topics from another ROS graph from satisfying readiness.
export ROS_DOMAIN_ID="${MAPEX_SIM_ROS_DOMAIN_ID:-42}"
export ROS_LOCALHOST_ONLY="${MAPEX_SIM_LOCALHOST_ONLY:-1}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"

# Recorder runs should return normally when exploration declares completion.
export MAPEX_RUNNER_AUTO_EXIT=1
export PYTHONPATH="${LAB_DIR}/runner_hooks${PYTHONPATH:+:${PYTHONPATH}}"

if ! "$PYTHON_BIN" -c 'import rclpy, yaml, numpy, rosgraph_msgs' >/dev/null 2>&1; then
    fail "ROS Python không hợp lệ: ${PYTHON_BIN}. Cần Python của ROS Jazzy (thường là /usr/bin/python3), không dùng Python Conda khác ABI."
fi

cleanup() {
    local status=$?
    trap - EXIT INT TERM

    if [[ -n "$LAUNCH_PID" ]] && kill -0 "$LAUNCH_PID" 2>/dev/null; then
        printf '\nĐang dừng simulation / SLAM / Nav2...\n'
        kill -INT "$LAUNCH_PID" 2>/dev/null || true

        for _ in {1..100}; do
            if ! kill -0 "$LAUNCH_PID" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done

        if kill -0 "$LAUNCH_PID" 2>/dev/null; then
            kill -TERM "$LAUNCH_PID" 2>/dev/null || true
        fi
    fi

    if [[ -n "$LAUNCH_PID" ]]; then
        wait "$LAUNCH_PID" 2>/dev/null || true
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

lifecycle_active() {
    local node="$1"
    timeout 3 ros2 lifecycle get "$node" 2>/dev/null | grep -Eq '^active([[:space:]]|$)'
}

cd "$ROOT_DIR"

printf '\nROS isolation: domain=%s, localhost_only=%s\n' "$ROS_DOMAIN_ID" "$ROS_LOCALHOST_ONLY"
printf 'ROS Python: %s\n' "$PYTHON_BIN"
printf 'Đang bật slam.launch.py | map=%s...\n' "$MAP_LABEL"
ros2 launch "${LAB_DIR}/launch/slam.launch.py" world:="$WORLD_SELECTOR" &
LAUNCH_PID=$!

printf 'Đang chờ Hospital/New Room thực sự sẵn sàng (/map, /odom, TF, Nav2 lifecycle)'
READY=0
DEADLINE=$((SECONDS + 180))
while (( SECONDS < DEADLINE )); do
    if ! kill -0 "$LAUNCH_PID" 2>/dev/null; then
        printf '\n'
        set +e
        wait "$LAUNCH_PID"
        launch_status=$?
        set -e
        fail "slam.launch.py đã thoát sớm (status=${launch_status})."
    fi

    map_ready=0
    odom_ready=0
    tf_ready=0
    nav_action_ready=0
    controller_ready=0
    planner_ready=0
    bt_ready=0

    if timeout 5 ros2 topic echo /map --once >/dev/null 2>&1; then
        map_ready=1
    fi
    if timeout 5 ros2 topic echo /odom --once >/dev/null 2>&1; then
        odom_ready=1
    fi
    if timeout 5 ros2 topic echo /tf --once >/dev/null 2>&1; then
        tf_ready=1
    fi
    if timeout 3 ros2 action list 2>/dev/null | grep -Fxq '/navigate_to_pose'; then
        nav_action_ready=1
    fi
    if lifecycle_active /controller_server; then
        controller_ready=1
    fi
    if lifecycle_active /planner_server; then
        planner_ready=1
    fi
    if lifecycle_active /bt_navigator; then
        bt_ready=1
    fi

    if (( map_ready && odom_ready && tf_ready && nav_action_ready && controller_ready && planner_ready && bt_ready )); then
        READY=1
        break
    fi

    printf '.'
    sleep 1
done
printf '\n'

if (( ! READY )); then
    printf 'Readiness cuối cùng:\n' >&2
    printf '  /map=%s /odom=%s /tf=%s navigate_to_pose=%s controller=%s planner=%s bt=%s\n' \
        "$map_ready" "$odom_ready" "$tf_ready" "$nav_action_ready" \
        "$controller_ready" "$planner_ready" "$bt_ready" >&2
    fail "Quá 180 giây nhưng simulation/Nav2 chưa sẵn sàng; không khởi động exploration để tránh tạo run lỗi."
fi

printf 'Stack đã sẵn sàng.\n'

if (( RECORD )); then
    if [[ "$METHOD" == "nf" ]]; then
        CMD=(
            "$PYTHON_BIN" "${LAB_DIR}/scripts/nf_run.py"
            --run-id "$RUN_ID"
            --environment "$ENVIRONMENT"
            --runtime-profile "$RUNTIME_PROFILE"
        )
    else
        CMD=(
            "$PYTHON_BIN" "${LAB_DIR}/scripts/mapex_run.py"
            --run-id "$RUN_ID"
            --environment "$ENVIRONMENT"
            --runtime-profile "$RUNTIME_PROFILE"
        )
    fi
else
    if [[ "$METHOD" == "nf" ]]; then
        CMD=("$PYTHON_BIN" "${LAB_DIR}/scripts/nf_basic.py")
    else
        CMD=("$PYTHON_BIN" "${LAB_DIR}/scripts/mapex.py")
    fi
fi

printf 'Bắt đầu: %s | map=%s' "$METHOD" "$MAP_LABEL"
if (( RECORD )); then
    printf ' | record=%s' "$RUN_ID"
else
    printf ' | record=no'
fi
printf '\nCtrl+C một lần để dừng toàn bộ.\n\n'
printf 'Command:'
printf ' %q' "${CMD[@]}"
printf '\n\n'

"${CMD[@]}"
