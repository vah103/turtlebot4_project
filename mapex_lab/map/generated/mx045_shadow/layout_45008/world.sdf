<?xml version="1.0"?>
<!-- Mini-Hospital auxiliary map. NW and SE corner branches are reachable only through neighboring rooms; NE and SW retain direct circulation-area entrances. Middle-room topology is intentionally asymmetric: the north middle pair forms a serial A->B branch where B has no direct corridor door, while a shifted south pair forms a small loop with both rooms retaining corridor access. N4+N5 and S4+S5 are merged into two large rooms with deliberately different LiDAR-visible obstacle layouts. S4+S5 uses one centered 2.40 m corridor door. The SW corner room is merged northward with the adjacent west-side chamber while the S1-S2 divider at x=-8 is retained; S1 uses an asymmetric mix of two offset blocks and one horizontal bar to avoid repetitive LiDAR signatures while preserving robot passage. Around the central circulation area, the east side keeps two columns while the west side uses one centered column. Central room keeps two perpendicular 1.30 m doors and a small angled LiDAR occlusion screen. Suggested spawn: (0,3,0). -->
<sdf version="1.9"><world name="new_room_world">
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<physics name="new_room_realtime" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics><gravity>0 0 -9.8</gravity><scene><ambient>0.85 0.85 0.87 1</ambient><background>0.68 0.68 0.71 1</background><shadows>false</shadows></scene><light name="sun" type="directional"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.95 0.95 0.95 1</diffuse><direction>-0.3 0.2 -1</direction></light>
<model name="new_room_ground"><static>true</static><link name="ground_link"><collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>40 32</size></plane></geometry></collision><visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>40 32</size></plane></geometry><material><ambient>0.92 0.92 0.94 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material></visual></link></model>
