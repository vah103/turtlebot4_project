<?xml version="1.0"?>
<!-- Mini-Hospital auxiliary map: 26x20 m, flat floor, 12 rooms, central loop. Central room has two 1.30 m doors on perpendicular north/east walls plus a small 0.90x0.15 m angled LiDAR occlusion screen. Suggested spawn: (0,3,0). -->
<sdf version="1.9"><world name="new_room_world">
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
