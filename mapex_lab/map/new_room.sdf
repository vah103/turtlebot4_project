<?xml version="1.0"?>
<!-- Self-contained Gazebo Sim port of EBang2k4/Omni_Boe_Robot omni_diff/worlds/new_room.world.
     Preserves the original Room wall / doorway box geometry and poses.
     Furniture meshes are intentionally omitted so mapex_lab has no external asset dependency.
     Auxiliary cross-environment test world; not part of hospital_v2. -->
<sdf version="1.9">
  <world name="new_room_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <physics name="new_room_realtime" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <gravity>0 0 -9.8</gravity>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.4 0.4 0.4 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="new_room_ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material></visual>
