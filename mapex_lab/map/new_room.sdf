<?xml version="1.0"?>
<!--
  mapex_lab mini-hospital auxiliary world.

  Single final new_room design:
  - 26 m x 20 m flat closed environment.
  - 12 patient-style rooms with 1.2 m door openings.
  - Central circulation loop around a closed utility core.
  - West/east dead-end wings and choke points.
  - Room obstacles / privacy screens for LiDAR occlusion and competing frontiers.
  - Self-contained primitive geometry; no external model or mesh dependency.

  Purpose: compact cross-environment MapEx / Nearest / Nav2 / SLAM debugging.
  This world is auxiliary and is NOT part of the canonical hospital_v2 benchmark.

  Suggested initial robot pose for future launch wiring: x=0.0, y=3.0, yaw=0.0.
-->
<sdf version="1.9">
  <world name="new_room_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="new_room_realtime" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.4 0.4 0.4 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="new_room_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>40 32</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>40 32</size></plane></geometry>
          <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Physical structure: outer shell, room bands, central loop/core, dead-end wings. -->

    <model name="outer_north">
      <static>true</static>
      <pose>0.000 10.000 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>26.000 0.180 2.500</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>26.000 0.180 2.500</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="outer_south">
      <static>true</static>
      <pose>0.000 -10.000 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>26.000 0.180 2.500</size></box></geometry></collision>
