# Raw experiment runs are local-only. This prevents pilot/official CSV/JSON/NPZ
# output from making the worktree dirty between benchmark runs.
experiments/**

# Hospital source world is tracked; downloaded model assets and generated scaled
# copies are local runtime data under mapex_lab/map.
map/models/
map/generated/

# Generated ground-truth / ROI artifacts
ground_truth/**/generated/

# Generated bulk results
results/raw/
results/cache/
results/**/*.npy
results/**/*.npz

# Python
__pycache__/
*.pyc
.venv/

# Keep lightweight summaries, figures and tables committed
!results/summary/
!results/summary/**
!results/figures/
!results/figures/**
!results/tables/
!results/tables/**
!results/oracle/
!results/oracle/**
