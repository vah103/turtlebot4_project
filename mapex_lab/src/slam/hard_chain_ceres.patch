+      if (!problem_->HasParameterBlock(&it->second(0)) ||
+          !problem_->HasParameterBlock(&it->second(1)) ||
+          !problem_->HasParameterBlock(&it->second(2)))
+      {
+        continue;
+      }
+
+      const bool is_newest = (it == newest);
+      const bool can_move = is_newest && nodes_->size() > 1;
