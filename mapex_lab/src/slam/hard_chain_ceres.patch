+  // Hard-chain experiment:
+  //   node 0 is the immutable root;
+  //   after node k has been solved once, it becomes immutable too;
+  //   only the newest node k+1 is allowed to move.
+  //
+  // In combination with scan_buffer_size=1 and do_loop_closing=false, the
+  // active graph is a sequential chain. Therefore the newest accepted scan
+  // is solved against the already-fixed previous scan/history and no later
+  // optimization is allowed to move any earlier pose.
+  if (g_hard_chain_enabled) {
+    GraphIterator newest = nodes_->begin();
+    for (GraphIterator it = nodes_->begin(); it != nodes_->end(); ++it) {
+      if (it->first > newest->first) {
+        newest = it;
+      }
+    }
+
