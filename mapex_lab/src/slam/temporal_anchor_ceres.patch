+// Experimental temporal anchoring for mapping mode.
+//
+// Goal:
+//   - keep the first pose fixed as upstream already does;
+//   - make early LOCAL pose-graph constraints stronger;
+//   - decay that extra confidence toward normal weight for later constraints;
+//   - do NOT strengthen long-gap loop-closure edges, so an accidental false
+//     loop is not given extra authority simply because it touches an old node.
+//
+// This is intentionally implemented with file-local state so the experiment
+// can be tested by replacing only ceres_solver.cpp, without changing the
+// upstream ceres_solver.hpp ABI. It assumes Karto scan unique IDs increase
+// monotonically during one mapping session, which is the behavior expected by
+// the current slam_toolbox graph construction.
+bool g_temporal_anchor_enabled = true;
+double g_temporal_anchor_min_weight = 1.0;
+double g_temporal_anchor_max_weight = 5.0;
+double g_temporal_anchor_decay_nodes = 50.0;
+int g_temporal_anchor_local_edge_max_gap = 5;
+
+double TemporalAnchorWeight(const int first_node_id, const int older_node_id)
+{
+  const double age = static_cast<double>(std::max(0, older_node_id - first_node_id));
+  const double decay = std::max(1.0, g_temporal_anchor_decay_nodes);
+  const double alpha = std::exp(-age / decay);
+  return g_temporal_anchor_min_weight +
+         (g_temporal_anchor_max_weight - g_temporal_anchor_min_weight) * alpha;
+}
+}  // namespace
 
