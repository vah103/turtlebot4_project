<!--
  Fast-fail NavigateToPose tree for path-guided intermediate-goal recovery.

  This keeps the normal 1 Hz global replanning pipeline, but deliberately omits
  Nav2's stock recovery loop (costmap clears / spin / wait / backup). If planning
  or FollowPath fails, NavigateToPose returns failure to nf_basic.py immediately.
  nf_basic.py then chooses a temporary point on the last main-goal global path,
  navigates to that subgoal, and retries the same frontier from the new pose.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithFastFailure">
      <ControllerSelector
        selected_controller="{selected_controller}"
        default_controller="FollowPath"
        topic_name="controller_selector"/>
      <PlannerSelector
        selected_planner="{selected_planner}"
        default_planner="GridBased"
        topic_name="planner_selector"/>
      <RateController hz="1.0">
        <ComputePathToPose
          goal="{goal}"
          path="{path}"
          planner_id="{selected_planner}"
          error_code_id="{compute_path_error_code}"/>
      </RateController>
      <FollowPath
        path="{path}"
        controller_id="{selected_controller}"
        error_code_id="{follow_path_error_code}"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
