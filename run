#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

LAUNCH_PID=""
EXPLORATION_PID=""
CLEANED_UP=0

cleanup() {
  if [[ "$CLEANED_UP" -eq 1 ]]; then
    return
  fi
  CLEANED_UP=1
  trap - INT TERM EXIT

  echo
  echo "Stopping experiment..."

  if [[ -n "$EXPLORATION_PID" ]] && kill -0 "$EXPLORATION_PID" 2>/dev/null; then
    kill -INT "$EXPLORATION_PID" 2>/dev/null || true
    wait "$EXPLORATION_PID" 2>/dev/null || true
  fi

  if [[ -n "$LAUNCH_PID" ]] && kill -0 "$LAUNCH_PID" 2>/dev/null; then
    kill -INT "$LAUNCH_PID" 2>/dev/null || true
    wait "$LAUNCH_PID" 2>/dev/null || true
  fi
}

trap cleanup INT TERM EXIT

if [[ ! -f /opt/ros/jazzy/setup.bash ]]; then
  echo "ERROR: /opt/ros/jazzy/setup.bash not found."
  exit 1
fi
source /opt/ros/jazzy/setup.bash

if [[ -f "$ROOT_DIR/ros2_ws/install/setup.bash" ]]; then
  source "$ROOT_DIR/ros2_ws/install/setup.bash"
else
  echo "WARNING: ros2_ws/install/setup.bash not found; using only /opt/ros/jazzy."
fi

export TURTLEBOT4_PROJECT_ROOT="$ROOT_DIR"

choose_method() {
  while true; do
    echo ""
    echo "Chon phuong phap:"
    echo "  1) NF"
    echo "  2) MapEx"
    read -r -p "> " choice
    case "$choice" in
      1|nf|NF)
        METHOD="nf"
        METHOD_LABEL="NF"
        return
        ;;
      2|mapex|MapEx|MAPEX)
        METHOD="mapex"
        METHOD_LABEL="MapEx"
        return
        ;;
      *) echo "Lua chon khong hop le. Chon 1 hoac 2." ;;
    esac
  done
}

choose_record() {
  while true; do
    echo ""
    echo "Co luu record khong?"
    echo "  1) Co"
    echo "  2) Khong"
    read -r -p "> " choice
    case "$choice" in
      1|y|Y|yes|YES|co|Co|CO)
        RECORD="yes"
        return
        ;;
      2|n|N|no|NO|khong|Khong|KHONG)
        RECORD="no"
        return
        ;;
      *) echo "Lua chon khong hop le. Chon 1 hoac 2." ;;
    esac
  done
}

ask_run_id() {
  local stamp default_id
  stamp="$(date +%Y%m%d_%H%M%S)"
  default_id="${METHOD}_${stamp}"

  while true; do
    echo ""
    read -r -p "Ten run [${default_id}]: " RUN_ID
    RUN_ID="${RUN_ID:-$default_id}"

    if [[ ! "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "Ten run chi nen gom chu, so, dau cham, gach duoi hoac gach ngang."
      continue
    fi

    local run_dir
    if [[ "$METHOD" == "nf" ]]; then
      run_dir="$ROOT_DIR/mapex_lab/experiments/nearest/$RUN_ID"
    else
      run_dir="$ROOT_DIR/mapex_lab/experiments/mapex/$RUN_ID"
    fi

    if [[ -e "$run_dir" ]]; then
      echo "Run da ton tai: $run_dir"
      echo "Hay chon ten khac de tranh ghi de du lieu."
      continue
    fi
    return
  done
}

wait_for_stack() {
  local timeout_s=90
  local elapsed=0

  echo ""
  echo "Dang cho /map va /navigate_to_pose san sang..."
  while (( elapsed < timeout_s )); do
    if ! kill -0 "$LAUNCH_PID" 2>/dev/null; then
      echo "ERROR: slam.launch.py da dung truoc khi stack san sang."
      return 1
    fi

    local have_map=0
    local have_nav=0

    if timeout 3 ros2 topic list 2>/dev/null | grep -qx '/map'; then
      have_map=1
    fi
    if timeout 3 ros2 action list 2>/dev/null | grep -qx '/navigate_to_pose'; then
      have_nav=1
    fi

    if [[ "$have_map" -eq 1 && "$have_nav" -eq 1 ]]; then
      echo "SLAM/Nav2 san sang."
      return 0
    fi

    sleep 1
    ((elapsed+=1))
  done

  echo "ERROR: qua ${timeout_s}s nhung /map hoac /navigate_to_pose chua san sang."
  return 1
}

choose_method
choose_record
if [[ "$RECORD" == "yes" ]]; then
  ask_run_id
fi

echo ""
echo "=============================="
echo "Method : $METHOD_LABEL"
echo "Record : $RECORD"
if [[ "$RECORD" == "yes" ]]; then
  echo "Run ID : $RUN_ID"
fi
echo "Launch : mapex_lab/launch/slam.launch.py"
echo "=============================="
echo ""

ros2 launch "$ROOT_DIR/mapex_lab/launch/slam.launch.py" &
LAUNCH_PID=$!

wait_for_stack

if [[ "$METHOD" == "nf" && "$RECORD" == "no" ]]; then
  EXPLORE_CMD=(python3 "$ROOT_DIR/mapex_lab/scripts/nf_basic.py")
elif [[ "$METHOD" == "mapex" && "$RECORD" == "no" ]]; then
  EXPLORE_CMD=(python3 "$ROOT_DIR/mapex_lab/scripts/mapex.py")
elif [[ "$METHOD" == "nf" && "$RECORD" == "yes" ]]; then
  EXPLORE_CMD=(python3 "$ROOT_DIR/mapex_lab/scripts/nf_run.py" --run-id "$RUN_ID" --environment new_room --runtime-profile slam)
else
  EXPLORE_CMD=(python3 "$ROOT_DIR/mapex_lab/scripts/mapex_run.py" --run-id "$RUN_ID" --environment new_room --runtime-profile slam)
fi

echo ""
echo "Starting $METHOD_LABEL..."
printf 'Command:'
printf ' %q' "${EXPLORE_CMD[@]}"
echo
echo "Nhan Ctrl+C mot lan de dung ca exploration va slam.launch.py."
echo ""

"${EXPLORE_CMD[@]}" &
EXPLORATION_PID=$!

set +e
wait "$EXPLORATION_PID"
EXPLORATION_STATUS=$?
set -e
EXPLORATION_PID=""

if [[ "$EXPLORATION_STATUS" -ne 0 && "$EXPLORATION_STATUS" -ne 130 ]]; then
  echo "Exploration ket thuc voi ma loi: $EXPLORATION_STATUS"
fi

cleanup
exit "$EXPLORATION_STATUS"
