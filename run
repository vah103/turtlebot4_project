#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

LAUNCH_PID=""
EXPLORATION_PID=""
CLEANED_UP=0

process_group_alive() {
  local pgid="$1"
  kill -0 -- "-$pgid" 2>/dev/null
}

wait_for_process_group_exit() {
  local pgid="$1"
  local timeout_s="$2"
  local elapsed=0

  while (( elapsed < timeout_s )); do
    if ! process_group_alive "$pgid"; then
      return 0
    fi
    sleep 1
    ((elapsed+=1))
  done
  return 1
}

stop_process_group() {
  local pgid="$1"
  local label="$2"

  if [[ -z "$pgid" ]] || ! process_group_alive "$pgid"; then
    return 0
  fi

  # First allow ROS 2 launch / Python nodes to perform a normal Ctrl+C-style
  # shutdown and flush files cleanly.
  kill -INT -- "-$pgid" 2>/dev/null || true
  if wait_for_process_group_exit "$pgid" 12; then
    wait "$pgid" 2>/dev/null || true
    return 0
  fi

  echo "WARNING: $label did not stop after SIGINT; sending SIGTERM..."
  kill -TERM -- "-$pgid" 2>/dev/null || true
  if wait_for_process_group_exit "$pgid" 5; then
    wait "$pgid" 2>/dev/null || true
    return 0
  fi

  echo "WARNING: $label still running; forcing SIGKILL..."
  kill -KILL -- "-$pgid" 2>/dev/null || true
  wait_for_process_group_exit "$pgid" 2 || true
  wait "$pgid" 2>/dev/null || true
}

cleanup() {
  if [[ "$CLEANED_UP" -eq 1 ]]; then
    return
  fi
  CLEANED_UP=1
  trap - INT TERM EXIT

  echo
  echo "Stopping experiment..."

  if [[ -n "$EXPLORATION_PID" ]]; then
    stop_process_group "$EXPLORATION_PID" "exploration"
    EXPLORATION_PID=""
  fi

  if [[ -n "$LAUNCH_PID" ]]; then
    stop_process_group "$LAUNCH_PID" "slam.launch.py"
    LAUNCH_PID=""
  fi

  echo "Experiment stopped."
}

trap cleanup INT TERM EXIT

if [[ ! -f /opt/ros/jazzy/setup.bash ]]; then
  echo "ERROR: /opt/ros/jazzy/setup.bash not found."
  exit 1
fi

# ROS/ament setup scripts may legitimately reference variables that are unset.
# Temporarily disable nounset while sourcing them, then restore strict mode.
set +u
source /opt/ros/jazzy/setup.bash

if [[ -f "$ROOT_DIR/ros2_ws/install/setup.bash" ]]; then
  source "$ROOT_DIR/ros2_ws/install/setup.bash"
else
  echo "WARNING: ros2_ws/install/setup.bash not found; using only /opt/ros/jazzy."
fi
set -u

export TURTLEBOT4_PROJECT_ROOT="$ROOT_DIR"

# Run ROS nodes with Ubuntu's system Python. The LaMa model itself is launched
# by mapex_lama_bridge.py with MAPEX_LAMA_PYTHON, so it keeps its dedicated
# legacy Conda environment without making rclpy depend on that environment.
if [[ -x /usr/bin/python3 ]]; then
  ROS_PYTHON="/usr/bin/python3"
else
  ROS_PYTHON="$(command -v python3 || true)"
fi

if [[ -z "$ROS_PYTHON" ]]; then
  echo "ERROR: Python 3 not found."
  exit 1
fi

if ! command -v setsid >/dev/null 2>&1; then
  echo "ERROR: setsid not found (normally provided by util-linux)."
  exit 1
fi

preflight_python() {
  if ! "$ROS_PYTHON" -c 'import rclpy, yaml, numpy' >/dev/null 2>&1; then
    echo "ERROR: ROS Python environment is incomplete: $ROS_PYTHON"
    echo "Expected imports: rclpy, yaml, numpy"
    echo "Check with: $ROS_PYTHON -c 'import rclpy, yaml, numpy; print(\"OK\")'"
    exit 1
  fi
}

configure_mapex_environment() {
  # Defaults are the known-good runtime paths on com1. Existing exported values
  # win, so the runner remains usable if the MapEx checkout/weights move later.
  export MAPEX_ROOT="${MAPEX_ROOT:-$HOME/MapEx}"
  export MAPEX_LAMA_PYTHON="${MAPEX_LAMA_PYTHON:-/work/conda-envs/lama/bin/python}"
  export MAPEX_ENSEMBLE_DIR="${MAPEX_ENSEMBLE_DIR:-/work/com1/mapex_weights/weights/lama_ensemble}"
  export MAPEX_DEVICE="${MAPEX_DEVICE:-cpu}"

  if [[ ! -d "$MAPEX_ROOT" ]]; then
    echo "ERROR: MAPEX_ROOT not found: $MAPEX_ROOT"
    exit 1
  fi
  if [[ ! -x "$MAPEX_LAMA_PYTHON" ]]; then
    echo "ERROR: MAPEX_LAMA_PYTHON not executable: $MAPEX_LAMA_PYTHON"
    exit 1
  fi
  if [[ ! -d "$MAPEX_ENSEMBLE_DIR" ]]; then
    echo "ERROR: MAPEX_ENSEMBLE_DIR not found: $MAPEX_ENSEMBLE_DIR"
    exit 1
  fi
}

choose_method() {
  while true; do
    echo ""
    echo "Chon phuong phap:"
    echo "  1) NF"
    echo "  2) MapEx"
    read -r -p "> " choice
    case "$choice" in
      1|nf|NF)
        METHOD="nf"
        METHOD_LABEL="NF"
        return
        ;;
      2|mapex|MapEx|MAPEX)
        METHOD="mapex"
        METHOD_LABEL="MapEx"
        return
        ;;
      *) echo "Lua chon khong hop le. Chon 1 hoac 2." ;;
    esac
  done
}

choose_record() {
  while true; do
    echo ""
    echo "Co luu record khong?"
    echo "  1) Co"
    echo "  2) Khong"
    read -r -p "> " choice
    case "$choice" in
      1|y|Y|yes|YES|co|Co|CO)
        RECORD="yes"
        return
        ;;
      2|n|N|no|NO|khong|Khong|KHONG)
        RECORD="no"
        return
        ;;
      *) echo "Lua chon khong hop le. Chon 1 hoac 2." ;;
    esac
  done
}

ask_run_id() {
  local stamp default_id
  stamp="$(date +%Y%m%d_%H%M%S)"
  default_id="${METHOD}_${stamp}"

  while true; do
    echo ""
    read -r -p "Ten run [${default_id}]: " RUN_ID
    RUN_ID="${RUN_ID:-$default_id}"

    if [[ ! "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "Ten run chi nen gom chu, so, dau cham, gach duoi hoac gach ngang."
      continue
    fi

    local run_dir
    if [[ "$METHOD" == "nf" ]]; then
      run_dir="$ROOT_DIR/mapex_lab/experiments/nearest/$RUN_ID"
    else
      run_dir="$ROOT_DIR/mapex_lab/experiments/mapex/$RUN_ID"
    fi

    if [[ -e "$run_dir" ]]; then
      echo "Run da ton tai: $run_dir"
      echo "Hay chon ten khac de tranh ghi de du lieu."
      continue
    fi
    return
  done
}

wait_for_stack() {
  local timeout_s=90
  local elapsed=0

  echo ""
  echo "Dang cho /map va /navigate_to_pose san sang..."
  while (( elapsed < timeout_s )); do
    if ! process_group_alive "$LAUNCH_PID"; then
      echo "ERROR: slam.launch.py da dung truoc khi stack san sang."
      return 1
    fi

    local have_map=0
    local have_nav=0

    if timeout 3 ros2 topic list 2>/dev/null | grep -qx '/map'; then
      have_map=1
    fi
    if timeout 3 ros2 action list 2>/dev/null | grep -qx '/navigate_to_pose'; then
      have_nav=1
    fi

    if [[ "$have_map" -eq 1 && "$have_nav" -eq 1 ]]; then
      echo "SLAM/Nav2 san sang."
      return 0
    fi

    sleep 1
    ((elapsed+=1))
  done

  echo "ERROR: qua ${timeout_s}s nhung /map hoac /navigate_to_pose chua san sang."
  return 1
}

choose_method
preflight_python
if [[ "$METHOD" == "mapex" ]]; then
  configure_mapex_environment
fi
choose_record
if [[ "$RECORD" == "yes" ]]; then
  ask_run_id
fi

echo ""
echo "=============================="
echo "Method : $METHOD_LABEL"
echo "Record : $RECORD"
if [[ "$RECORD" == "yes" ]]; then
  echo "Run ID : $RUN_ID"
fi
echo "Python : $ROS_PYTHON"
if [[ "$METHOD" == "mapex" ]]; then
  echo "MapEx  : $MAPEX_ROOT"
  echo "LaMa   : $MAPEX_LAMA_PYTHON"
  echo "Weights: $MAPEX_ENSEMBLE_DIR"
  echo "Device : $MAPEX_DEVICE"
fi
echo "Launch : mapex_lab/launch/slam.launch.py"
echo "=============================="
echo ""

# Run launch in its own process group so cleanup can stop the complete ROS/Gazebo
# tree instead of only the ros2 launch parent process.
setsid ros2 launch "$ROOT_DIR/mapex_lab/launch/slam.launch.py" &
LAUNCH_PID=$!

wait_for_stack

if [[ "$METHOD" == "nf" && "$RECORD" == "no" ]]; then
  EXPLORE_CMD=("$ROS_PYTHON" "$ROOT_DIR/mapex_lab/scripts/nf_basic.py")
elif [[ "$METHOD" == "mapex" && "$RECORD" == "no" ]]; then
  EXPLORE_CMD=("$ROS_PYTHON" "$ROOT_DIR/mapex_lab/scripts/mapex.py")
elif [[ "$METHOD" == "nf" && "$RECORD" == "yes" ]]; then
  EXPLORE_CMD=("$ROS_PYTHON" "$ROOT_DIR/mapex_lab/scripts/nf_run.py" --run-id "$RUN_ID" --environment new_room --runtime-profile slam)
else
  EXPLORE_CMD=("$ROS_PYTHON" "$ROOT_DIR/mapex_lab/scripts/mapex_run.py" --run-id "$RUN_ID" --environment new_room --runtime-profile slam)
fi

echo ""
echo "Starting $METHOD_LABEL..."
printf 'Command:'
printf ' %q' "${EXPLORE_CMD[@]}"
echo
echo "Run hoan tat se tu dong dung exploration, SLAM, Nav2 va Gazebo."
echo "Nhan Ctrl+C mot lan neu muon dung som."
echo ""

# Give exploration (and the MapEx LaMa worker, when used) its own process group
# so an early Ctrl+C can clean the whole tree reliably.
setsid "${EXPLORE_CMD[@]}" &
EXPLORATION_PID=$!

set +e
wait "$EXPLORATION_PID"
EXPLORATION_STATUS=$?
set -e
EXPLORATION_PID=""

if [[ "$EXPLORATION_STATUS" -ne 0 && "$EXPLORATION_STATUS" -ne 130 ]]; then
  echo "Exploration ket thuc voi ma loi: $EXPLORATION_STATUS"
fi

# Normal completion reaches here only after the recorder has printed SAVED and
# OFFLINE EVAL. Now stop the full simulation/navigation stack before returning
# the shell prompt.
cleanup
exit "$EXPLORATION_STATUS"
