<?xml version="1.0"?>
<!--
  Flat-floor variant of the AWS RoboMaker Hospital layout.

  The original Hospital floor mesh contains steps / height changes and exposed
  edges that can behave like negative obstacles for a 2D lidar robot.  This
  world deliberately removes that floor mesh and keeps the Hospital wall mesh
  on one continuous z=0 ground plane.  The corridor / room wall layout is
  therefore preserved while every drivable location is physically flat.

  This world is intended for frontier exploration and LaMa snapshot experiments,
  where negative-obstacle handling is not the behavior under test.
-->
<sdf version="1.9">
  <world name="hospital_flat_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Keep /clock deterministic even when the server is launched headless.
         A target real-time factor of 1 prevents the physics clock from racing
         ahead just because no Gazebo client is rendering the scene. -->
    <physics name="hospital_realtime" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.4 0.4 0.4 1</background>
      <shadows>false</shadows>
    </scene>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
    </include>

    <!--
      One continuous horizontal collision plane at z=0.  Do not re-introduce
      the aws_robomaker_hospital_floor_01_floor collision model here: its
      height changes are exactly what this flat test world is designed to avoid.
    -->
    <model name="hospital_flat_ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.80 0.80 0.82 1</ambient>
            <diffuse>0.80 0.80 0.82 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Preserve the original AWS Hospital corridor / room wall geometry. -->
    <include>
      <name>hospital_walls</name>
      <uri>model://aws_robomaker_hospital_floor_01_walls</uri>
      <pose>-0.013823 -0.013783 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!--
      The stripped structural world does not load the two elevator door models
      used by the original AWS scene, leaving two openings at the north end of
      the corridor.  Close those openings with ordinary physical geometry so
      lidar / SLAM sees a wall and frontier exploration cannot leave the
      building.  These are real collision walls, not Nav2 keepout regions.

      Their x/y positions follow the two elevator-door poses from the original
      Hospital scene.  The 1.60 m width safely covers the ~1.42 m door collision
      mesh while the 0.18 m thickness overlaps the surrounding wall enough to
      avoid narrow navigation gaps.
    -->
    <model name="elevator_opening_blocker_left">
      <static>true</static>
      <pose>-1.51 19.35 1.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.60 0.18 2.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.60 0.18 2.60</size></box></geometry>
          <material>
            <ambient>0.86 0.86 0.86 1</ambient>
            <diffuse>0.86 0.86 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="elevator_opening_blocker_right">
      <static>true</static>
      <pose>1.52843 19.3627 1.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.60 0.18 2.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.60 0.18 2.60</size></box></geometry>
          <material>
            <ambient>0.86 0.86 0.86 1</ambient>
            <diffuse>0.86 0.86 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
