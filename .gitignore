# ROS 2 / colcon generated directories
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/
install/
log/

# ROS bag binary payloads
*.mcap
*.db3
**/rosbag/*.mcap
**/rosbag/*.db3

# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/

# LaMa local assets and generated experiment data
# Keep code/config in Git, but do not commit the upstream LaMa checkout,
# model checkpoints, full fixed-canvas runs, or generated predictions.
third_party/lama/
models/lama/
results/lama/
data/lama_runs/*
!data/lama_runs/README.md

# Common model/checkpoint payloads
*.ckpt
*.pth
*.pt

# Editors and local environment
.vscode/
.idea/
*.swp

# Temporary and backup files
*.tmp
*.bak
*~
.DS_Store
